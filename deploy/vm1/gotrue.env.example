# deploy/vm1/gotrue.env.example: NAMES ONLY. Never write a value into this file.
#
# The real file lives at /opt/clics/env/gotrue.env on vm1 (owner clics, mode 600). A human creates it EMPTY
# with `install -o clics -g clics -m 600 /dev/null`, then fills it in with an editor on vm1. It never enters
# git, a chat, a ticket or deploy.sh's tarball (#427, ADR 0012). Each name is marked:
#   [new]      generated on vm1 for the self-hosted stack; Supabase's value is never reused
#   [host]     depends on where the database and the public origin are; the note says what
#   [compose]  pinned in docker-compose.auth.yml; do NOT set it here (compose would override it anyway)
# The preflight (remote/lib.sh, check_auth_env) refuses this file without postgrest.env, at the wrong mode or
# owner, with a required name blank, with GOTRUE_JWT_SECRET different from postgrest.env's PGRST_JWT_SECRET,
# or with any of these secrets in backend.env or rimpl.env.

# ---- Secrets ------------------------------------------------------------------------------------------
# [new] Signs every access token. `openssl rand -base64 48` on vm1, once. The SAME value goes into
#       postgrest.env as PGRST_JWT_SECRET, written the same way (unquoted). A new secret means every user
#       signs in once after the move (ADR 0012). The backend's and rimpl's SUPABASE_ANON_KEY and
#       SUPABASE_SERVICE_ROLE_KEY are minted from it with auth-role-keys.cjs (README, Self-hosted sign-in).
GOTRUE_JWT_SECRET=
# [host] postgres://supabase_auth_admin:PASSWORD@DATA_HOST:5432/postgres?sslmode=... The role is
#        supabase/postgres's own; its password is set on the data host (#432), or in the rehearsal.
GOTRUE_DB_DATABASE_URL=
# [new] A Resend API key used as the SMTP password (user `resend`), for OTP and reset mail. A separate key
#       from the backend's RESEND_API_KEY, so either can be revoked alone. The invite email stays on the
#       backend's HTTPS API.
GOTRUE_SMTP_PASS=
# [host] The Google OAuth client's secret. The client id below must equal CLICS_GOOGLE_CLIENT_ID in
#        physician-ui/public/js/google-config.js, or the id_token audience check fails.
GOTRUE_EXTERNAL_GOOGLE_SECRET=

# ---- Settings -----------------------------------------------------------------------------------------
# [host] The public ORIGIN, no path: https://clics.ccme.or.th. Mail links are this plus the /auth/v1/verify
#        paths compose pins.
API_EXTERNAL_URL=
# [host] The issuer claim in access tokens: https://clics.ccme.or.th/auth/v1. Nothing in CLICS reads it.
GOTRUE_JWT_ISSUER=
# [host] Access token lifetime in seconds: 3600, Supabase's default. The rehearsal compares it with the
#        hosted project's tokens.
GOTRUE_JWT_EXP=
# [host] The Portal root (ADR 0003): where GoTrue sends a redirect that is not on the allow-list.
GOTRUE_SITE_URL=
# [host] Comma-separated redirect allow-list: each Portal origin's /auth/callback and /reset (#429 moves the
#        Portal to clics.ccme.or.th).
GOTRUE_URI_ALLOW_LIST=
# [host] smtp.resend.com
GOTRUE_SMTP_HOST=
# [host] 465 (implicit TLS), or 587 if vm1's egress allows only that (question 5 to CME, spec #423).
GOTRUE_SMTP_PORT=
# [host] resend
GOTRUE_SMTP_USER=
# [host] The sender address, on a domain verified in Resend.
GOTRUE_SMTP_ADMIN_EMAIL=
# [host] CLICS
GOTRUE_SMTP_SENDER_NAME=
# [host] The Google OAuth client id (the same one the Portal uses).
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
# [host] https://clics.ccme.or.th/auth/v1/callback, registered as a redirect URI on the Google client.
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=
# [host] OTP length and lifetime for the invite and reset mail: 6 and 3600, Supabase's defaults. Copy the
#        hosted project's values if its Auth settings differ.
GOTRUE_MAILER_OTP_LENGTH=
GOTRUE_MAILER_OTP_EXP=

# [compose] GOTRUE_API_HOST, PORT, GOTRUE_DB_DRIVER, GOTRUE_JWT_ADMIN_ROLES, GOTRUE_JWT_AUD,
#           GOTRUE_JWT_DEFAULT_GROUP_NAME, GOTRUE_DISABLE_SIGNUP, GOTRUE_EXTERNAL_EMAIL_ENABLED,
#           GOTRUE_EXTERNAL_PHONE_ENABLED, GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED,
#           GOTRUE_EXTERNAL_GOOGLE_ENABLED, GOTRUE_MAILER_AUTOCONFIRM,
#           GOTRUE_SECURITY_MANUAL_LINKING_ENABLED, GOTRUE_LOG_LEVEL, GOTRUE_MAILER_TEMPLATES_*,
#           GOTRUE_MAILER_SUBJECTS_*, GOTRUE_MAILER_URLPATHS_*.
