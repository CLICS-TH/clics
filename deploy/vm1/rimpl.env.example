# deploy/vm1/rimpl.env.example: NAMES ONLY. Never write a value into this file.
#
# The real file lives at /opt/clics/env/rimpl.env on vm1 (owner clics, mode 600). A human fills it in
# on the host; it never enters git, a chat, a ticket or deploy.sh's tarball. Names were taken from
# Railway's rimpl service on 2026-10-21 (keys only). Markers as in backend.env.example:
#   [same] copy from Railway byte for byte · [vm1] changes on vm1 · [compose] set in docker-compose.yml
#   [drop] Railway-only, never set on vm1
# For an optional name you do not need, delete the line. A blank `NAME=` sets it to "" (not unset).

# ---- Required -------------------------------------------------------------------------------------
# [vm1] Must equal INTERNAL_TOKEN in backend.env byte for byte (the vm1 pair only; see that file).
#       rimpl refuses to boot in production without it (rimpl/src/index.js:19-21).
INTERNAL_TOKEN=
# [same]
ANTHROPIC_API_KEY=
# [same] The Supabase project (Tokyo).
SUPABASE_URL=
# [same]
SUPABASE_SERVICE_ROLE_KEY=

# ---- On-prem model block: DECLARED, never routed (#424) ------------------------------------------
# Two instances of one transport (rimpl/src/services/providers/local-factory.js): `local` is the
# EVALUATOR (LOCAL_AI_*), `local-tutor` is the TUTOR (LOCAL_TUTOR_AI_*). CCME R3: they must be two
# model artifacts, so the preflight refuses a file where both resolve to the same base URL and model.
# Declared only: nothing routes a purpose to either. The preflight refuses any AI_PROVIDER*,
# EMBED_PROVIDER, SHADOW_EVAL_PROVIDER or CHAT_FAILOVER_PROVIDER line here that names `local` or
# `local-tutor`. Prove both answer with deploy/vm1/model-reach.cjs (README, "On-prem model block").
#
# rimpl reaches them through the HOST's routes: vm1's kernel Tailscale (tailscale0) or its GDCC LAN
# interface, via docker's default NAT egress. Nothing Tailscale runs inside the container. On the
# tailnet the traffic arrives from vm1's own tailnet address, so the model host's rules must admit vm1.
# A tailnet MagicDNS name may not resolve inside a container (docker's DNS forwards to the host's
# upstream resolvers); if it does not, put the address here, in this file on the host only, never in
# the repo. Every name below is [vm1]: changes on vm1, whatever Railway holds. Required for the block:
# BASE_URL and MODEL of each; the rest are optional (delete a line you do not need).
#
# [vm1] Evaluator. The OpenAI-compatible base, ending where /models and /chat/completions hang off it.
LOCAL_AI_BASE_URL=
# [vm1] Evaluator model id, exactly as its /models lists it.
LOCAL_AI_MODEL=
# [vm1] Evaluator bearer key.
LOCAL_AI_API_KEY=
# [vm1] Optional evaluator knobs (defaults in local-factory.js): call deadline, context floor, per-request
#       context, prompt-size backstop, how thinking is switched, a template that opens <think> itself.
LOCAL_AI_TIMEOUT_MS=
LOCAL_AI_MIN_CONTEXT=
LOCAL_AI_NUM_CTX=
LOCAL_AI_MAX_PROMPT_TOKENS=
LOCAL_AI_THINKING_STYLE=
LOCAL_AI_THINK_PREOPENED=
# [vm1] Optional, a reasoning model only. Its reasoning tokens count against max_tokens, so criteria's 200
#       is eaten before the answer starts and the reply comes back empty (a retryable 503 empty_reply).
#       The larger of this and the route's own max_tokens is sent and recorded. Unset = the route's value.
LOCAL_AI_MAX_TOKENS_FLOOR_CRITERIA=
LOCAL_AI_MAX_TOKENS_FLOOR_EVALUATE=
LOCAL_AI_MAX_TOKENS_FLOOR_SHADOW=
LOCAL_AI_MAX_TOKENS_FLOOR_CHAT=
LOCAL_AI_MAX_TOKENS_FLOOR_DISCUSS=
# [vm1] Optional, only if ai_provider_embed is ever `local` (it is not, in this ticket).
LOCAL_AI_EMBED_MODEL=
LOCAL_AI_EMBED_TIMEOUT_MS=
# [vm1] Tutor. A different endpoint, model and key from the evaluator's.
LOCAL_TUTOR_AI_BASE_URL=
# [vm1] Tutor model id, exactly as its /models lists it.
LOCAL_TUTOR_AI_MODEL=
# [vm1] Tutor bearer key.
LOCAL_TUTOR_AI_API_KEY=
# [vm1] Optional tutor knobs, as the evaluator's. The tutor has no embeddings.
LOCAL_TUTOR_AI_TIMEOUT_MS=
LOCAL_TUTOR_AI_MIN_CONTEXT=
LOCAL_TUTOR_AI_NUM_CTX=
LOCAL_TUTOR_AI_MAX_PROMPT_TOKENS=
LOCAL_TUTOR_AI_THINKING_STYLE=
LOCAL_TUTOR_AI_THINK_PREOPENED=
# [vm1] Optional, as the evaluator's floors. The tutor serves chat and discuss only.
LOCAL_TUTOR_AI_MAX_TOKENS_FLOOR_CHAT=
LOCAL_TUTOR_AI_MAX_TOKENS_FLOOR_DISCUSS=

# ---- [compose] set in docker-compose.yml, never here ----------------------------------------------
#   PORT 3003 · NODE_ENV production · NODE_OPTIONS heap ceiling under the memory limit

# ---- [drop] Railway-only, never set on vm1 --------------------------------------------------------
#   TS_AUTHKEY           Set, it starts a userspace tailscaled INSIDE the container (rimpl/docker-entrypoint.sh)
#                        and joins a second node to the tailnet. vm1's own Tailscale already routes.
#   LOCAL_AI_HTTP_PROXY, LOCAL_TUTOR_AI_HTTP_PROXY
#                        Point at that in-container userspace proxy, which does not exist on vm1. Set,
#                        every on-prem model call would fail (rimpl/src/services/providers/local-factory.js).
#   RAILWAY_ENVIRONMENT, RAILWAY_ENVIRONMENT_ID, RAILWAY_ENVIRONMENT_NAME, RAILWAY_PRIVATE_DOMAIN,
#   RAILWAY_PROJECT_ID, RAILWAY_PROJECT_NAME, RAILWAY_SERVICE_BACKEND_URL, RAILWAY_SERVICE_ID,
#   RAILWAY_SERVICE_NAME (injected by Railway)
