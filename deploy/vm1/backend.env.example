# deploy/vm1/backend.env.example: NAMES ONLY, with one exception: RECONCILE_INTERVAL_MS=0, a safety
# setting rather than a secret (see its note). Never write any other value into this file.
#
# The real file lives at /opt/clics/env/backend.env on vm1 (owner clics, mode 600). A human fills it
# in on the host; it never enters git, a chat, a ticket or deploy.sh's tarball. Names were taken from
# Railway's backend service on 2026-10-21 (keys only). Each one is marked:
#   [same]     copy the value from Railway's backend service byte for byte
#   [vm1]      the value is different on vm1; the note says how
#   [compose]  set in docker-compose.yml; do NOT set it here
#   [drop]     Railway-only; never set on vm1 (see the end of this file)
# For an optional name you do not need, delete the line. A blank `NAME=` sets it to "" (not unset).
# Moving the app does NOT move the data: the database stays in Supabase, Tokyo.

# ---- Required by the production boot check (backend/src/index.js:12) ----------------------------
# [same] The Supabase project (Tokyo).
SUPABASE_URL=
# [same]
SUPABASE_SERVICE_ROLE_KEY=
# [same]
SUPABASE_ANON_KEY=
# [vm1] Shared with vm1's rimpl ONLY, and must equal INTERNAL_TOKEN in rimpl.env byte for byte. The
#       vm1 pair talks to nobody else, so generate a fresh one (e.g. `openssl rand -base64 48`) rather
#       than reusing Railway's. Write both lines the same way, unquoted: deploy.sh's preflight refuses
#       unless each file has exactly one INTERNAL_TOKEN= line and the two are byte-identical, and every
#       backend start by deploy.sh (deploy, rollback, restore) comes after gate 1 has proved rimpl
#       accepts the backend's token. A backend started by hand on vm1 gets neither check.
INTERNAL_TOKEN=
# [same] HMAC key for guest tokens.
GUEST_TOKEN_SECRET=
# [same] MUST be byte-identical to Railway's: it decrypts the identity vault and the ple_pii_map rows
#        already in the shared database. A different value cannot decrypt them.
IDENTITY_ENC_KEY=
# [vm1] https://clics.ccme.or.th, the one origin the Portal and the dashboard are served from (#429).
#       Their calls to /api are same-origin and need no CORS, but the backend refuses to boot without a
#       value, and a page that sends an Origin header must find its own here.
ALLOWED_ORIGINS=
# [vm1] https://clics.ccme.or.th, for invite and password-reset links: the Portal is served there.
SITE_URL=
# [compose] RIMPL_URL: http://rimpl:3003, set in docker-compose.yml.

# ---- Also required in production ------------------------------------------------------------------
# [same] Must be `manual` (or tmc_scrape with LICENSE_VERIFIER_URL). The backend refuses to boot on
#        the stub or an unknown value (backend/src/index.js:24-30).
LICENSE_VERIFIER_ADAPTER=

# ---- Optional, set on Railway today ---------------------------------------------------------------
# [same]
INVITE_EXPIRY_DAYS=
# [same]
MAIL_FROM=
# [same]
OAUTH_ENABLED=
# [same] Invite mail goes through the Resend HTTPS API (backend/src/lib/mailer.js).
RESEND_API_KEY=
# [same] Inert while RESEND_API_KEY is set; kept so the two hosts stay identical.
SMTP_HOST=
# [same]
SMTP_PORT=
# [same]
SMTP_USER=
# [same]
SMTP_PASS=

# ---- vm1 only -------------------------------------------------------------------------------------
# [vm1] Keep it at 0 while Railway's backend is still running. The 6-hourly reconcile sweep re-runs
#       tier-2 screening on sessions stuck at 'ended' WITHOUT a lease (backend/src/services/reconcile.js:49-88),
#       so two backends sweeping at once can classify and meter the same session twice. A BLANK value is
#       not 0: the backend reads `value || 6h` (backend/src/index.js), so `RECONCILE_INTERVAL_MS=` turns
#       the sweep ON. The preflight refuses a blank or non-numeric value, and refuses any non-zero value
#       (or a missing line, which is also every 6 h) unless this file also holds the line
#       CLICS_CUTOVER_DONE=1. Add that line, and delete this one or set a positive interval, only once
#       Railway's backend is stopped (deploy/vm1/README.md, cutover step 5). CLICS_CUTOVER_DONE is read
#       by deploy.sh's preflight, not by the backend.
RECONCILE_INTERVAL_MS=0
# [vm1] Local-only mode (ADR 0012, #428): the SAME value as CLICS_LOCAL_ONLY in rimpl.env. The provider
#       switch hides and refuses every commercial provider when this line OR rimpl's is on (or rimpl's
#       cannot be read). rimpl.env is the one that refuses the calls, so the preflight refuses on here with
#       off there. Unset or blank is off.
CLICS_LOCAL_ONLY=

# ---- [compose] set in docker-compose.yml, never here ----------------------------------------------
#   PORT            3001 inside the container (published on the host as loopback 3101)
#   NODE_ENV        production. This is what makes the backend treat itself as production on vm1,
#                   where RAILWAY_ENVIRONMENT does not exist.
#   NODE_OPTIONS    heap ceiling under the container's memory limit
#   RIMPL_URL       http://rimpl:3003

# ---- [drop] Railway-only, never set on vm1 --------------------------------------------------------
#   RAILWAY_ENVIRONMENT, RAILWAY_ENVIRONMENT_ID, RAILWAY_ENVIRONMENT_NAME, RAILWAY_PRIVATE_DOMAIN,
#   RAILWAY_PROJECT_ID, RAILWAY_PROJECT_NAME, RAILWAY_PUBLIC_DOMAIN, RAILWAY_SERVICE_BACKEND_URL,
#   RAILWAY_SERVICE_ID, RAILWAY_SERVICE_NAME, RAILWAY_STATIC_URL (injected by Railway)
