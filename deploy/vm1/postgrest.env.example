# deploy/vm1/postgrest.env.example: NAMES ONLY. Never write a value into this file.
#
# The real file lives at /opt/clics/env/postgrest.env on vm1 (owner clics, mode 600), filled in by a human
# on the host, like gotrue.env (see its header for the markers and what the preflight refuses).

# [new] The SAME value as GOTRUE_JWT_SECRET in gotrue.env, written the same way (unquoted). PostgREST
#       verifies the service_role key the backend and rimpl send with it.
PGRST_JWT_SECRET=
# [host] postgres://authenticator:PASSWORD@DATA_HOST:5432/postgres?sslmode=... The role is supabase/postgres's
#        own login role, which switches to service_role per request.
PGRST_DB_URI=

# [compose] PGRST_DB_SCHEMAS, PGRST_DB_EXTRA_SEARCH_PATH, PGRST_DB_ANON_ROLE, PGRST_DB_MAX_ROWS,
#           PGRST_DB_USE_LEGACY_GUCS, PGRST_ADMIN_SERVER_HOST, PGRST_ADMIN_SERVER_PORT.
