# Audit Dashboard — Next.js environment variables
# The dashboard is served at /audit on the Portal's origin, and the backend at /api on the same origin
# (vm1's nginx; locally `npm run dev` from the repo root, http://localhost:3080). Unset = /api.
NEXT_PUBLIC_API_URL=/api
# The Portal's origin, no trailing slash. Leave unset: the Portal shares this origin, and the dashboard
# reads the Portal's localStorage session, which only a same-origin Portal can write.
NEXT_PUBLIC_PORTAL_URL=

# Supabase browser client (public anon key) — for Google sign-in + password reset.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
