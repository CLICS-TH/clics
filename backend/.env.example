SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public anon key — used to mint browser sign-in links; NEVER put the service-role key in a browser.
SUPABASE_ANON_KEY=your-anon-key
RIMPL_URL=http://localhost:3003
INTERNAL_TOKEN=change-me-to-a-random-secret
ALLOWED_ORIGINS=
PORT=3001

# AES-256-GCM key for the on-prem OAuth/identity vault (REQUIRED in production).
IDENTITY_ENC_KEY=change-me-long-random-string

# --- Auth / signup overhaul (see docs/AUTH-SETUP.md) ---
# Enable real Google sign-in + OAuth routes (needs the Supabase Google provider configured).
OAUTH_ENABLED=false
# Base URL of the user-facing site, for OAuth/redirect + password-reset links.
SITE_URL=http://localhost:3000
# Invite links expire after this many days.
INVITE_EXPIRY_DAYS=7

# --- License verification ---
# Adapter: 'stub' (deterministic, no network) or 'tmc_scrape' (calls the scraper microservice).
LICENSE_VERIFIER_ADAPTER=stub
# Dedicated Playwright scraper microservice (only used when adapter=tmc_scrape).
LICENSE_VERIFIER_URL=http://localhost:3004
# Resilience tuning (defaults shown):
LICENSE_SCRAPE_TIMEOUT_MS=20000
LICENSE_CACHE_TTL_MS=21600000
LICENSE_CB_THRESHOLD=5
LICENSE_CB_COOLDOWN_MS=300000

# Scheduled sweep re-evaluating sessions stranded at cle_pass with no AI score (ms between runs; 0 disables). Default: 6h.
RECONCILE_INTERVAL_MS=21600000

# --- Invite emails (backend mailer; fail-soft — leave unset to disable email and use copy-link) ---
# SMTP server hostname; mailer is enabled only when BOTH SMTP_HOST and MAIL_FROM are set.
SMTP_HOST=
# SMTP port (587 = STARTTLS, the default).
SMTP_PORT=587
# SMTP username (optional — omit for an unauthenticated relay).
SMTP_USER=
# SMTP password (paired with SMTP_USER).
SMTP_PASS=
# From address for invite emails, e.g. "CLICS <no-reply@your-domain>".
MAIL_FROM=
