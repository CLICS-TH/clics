SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public anon key — used to mint browser sign-in links; NEVER put the service-role key in a browser.
SUPABASE_ANON_KEY=your-anon-key
RIMPL_URL=http://localhost:3003
# D3 only: set after on-prem RIMPL is reachable and authenticated. Unset keeps direct access.
# Use with the optional Tailscale client in backend/Dockerfile, or another local HTTP proxy.
RIMPL_HTTP_PROXY=
# Tailscale joins only when a fresh auth key is supplied at deployment (never commit the key).
TS_AUTHKEY=
TS_HOSTNAME=clics-backend
TS_PROXY_PORT=1055
TS_UP_TIMEOUT=20s
INTERNAL_TOKEN=change-me-to-a-random-secret
ALLOWED_ORIGINS=
PORT=3001

# AES-256-GCM key for the on-prem OAuth/identity vault (REQUIRED in production).
IDENTITY_ENC_KEY=change-me-long-random-string

# HMAC secret for ephemeral guest-mode tokens (REQUIRED in production; dev falls back to an insecure default).
GUEST_TOKEN_SECRET=change-me-long-random-string

# --- Auth / signup overhaul (see docs/AUTH-SETUP.md) ---
# Enable real Google sign-in + OAuth routes (needs the Supabase Google provider configured).
OAUTH_ENABLED=false
# Base URL of the user-facing site, for OAuth/redirect + password-reset links.
SITE_URL=http://localhost:3000
# Invite links expire after this many days.
INVITE_EXPIRY_DAYS=7

# --- License verification ---
# Adapter: 'stub' (deterministic, no network) or 'tmc_scrape' (calls the scraper microservice).
LICENSE_VERIFIER_ADAPTER=stub
# Dedicated Playwright scraper microservice (only used when adapter=tmc_scrape).
LICENSE_VERIFIER_URL=http://localhost:3004
# Resilience tuning (defaults shown):
LICENSE_SCRAPE_TIMEOUT_MS=20000
LICENSE_CACHE_TTL_MS=21600000
LICENSE_CB_THRESHOLD=5
LICENSE_CB_COOLDOWN_MS=300000

# Scheduled sweep for sessions stranded at ple_pass with no AI score (ms between runs; 0 disables). Default: 6h.
# It re-ENQUEUES them for the evaluation drain below; it no longer calls the evaluator itself.
RECONCILE_INTERVAL_MS=21600000

# --- Evaluation queue (the ple_pass row IS the queue; eval-drain.js is the only caller of rimpl /evaluate) ---
# Fallback tick: how often the drain looks for claimable rows without being kicked (ms). 0 turns the tick off
# (kick-only; a deferred retry then waits for the next kick). The drain itself always runs.
EVAL_DRAIN_INTERVAL_MS=60000
# Evaluations in flight at once from this backend. Also a live superadmin setting (eval_drain_concurrency) that wins when set.
# The on-prem model measured p95 114s at 2 concurrent and 154s at 4, so 1–2 is the honest range.
EVAL_DRAIN_CONCURRENCY=1
# A claimed row that has not finished within the lease is claimable again (seconds). Keep above RIMPL_EVAL_TIMEOUT_MS/1000.
EVAL_LEASE_S=600
# After this many attempts the row is flagged for a human (ple_flag_t2 + ple.eval_exhausted) instead of retried.
EVAL_MAX_ATTEMPTS=20
# DEV ONLY — drain only these council codes (comma-separated). Used by a laptop stack pointed at the prod DB so it
# scores ONLY the SANDBOX council. The backend REFUSES TO START with this set in production (the prod side uses the
# superadmin setting eval_drain_exclude_councils instead).
EVAL_DRAIN_ONLY_COUNCILS=

# --- rimpl call budgets (ms) ---
# PIS-7 evaluation: covers 2–3 serial local-model calls (adaptive self-consistency) plus rimpl's own queue wait.
RIMPL_EVAL_TIMEOUT_MS=480000
# C1–C6 criteria screening runs inside the physician's /end request, so it stays short.
RIMPL_CRITERIA_TIMEOUT_MS=180000

# --- Invite emails (backend mailer; fail-soft — leave unset to disable email and use copy-link) ---
# SMTP server hostname; mailer is enabled only when BOTH SMTP_HOST and MAIL_FROM are set.
SMTP_HOST=
# SMTP port (587 = STARTTLS, the default).
SMTP_PORT=587
# SMTP username (optional — omit for an unauthenticated relay).
SMTP_USER=
# SMTP password (paired with SMTP_USER).
SMTP_PASS=
# From address for invite emails, e.g. "CLICS <no-reply@your-domain>".
MAIL_FROM=
