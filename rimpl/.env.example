SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-your-key
OPENAI_API_KEY=sk-your-key
INTERNAL_TOKEN=change-me-to-a-random-secret
PORT=3003

# --- Request size ------------------------------------------------------------------------------
# JSON body ceiling. /chat resends the whole history every turn, so express.json()'s 100kb default
# would refuse a long PLE before any route ran. Keep it above the transcript cap with headroom.
RIMPL_BODY_LIMIT=2mb

# --- Provider routing (see docs/LOCAL-MODEL-ROADMAP.md) ---------------------------------------
# Resolution per call: app_settings.ai_provider_<purpose> -> AI_PROVIDER_<PURPOSE> -> AI_PROVIDER -> anthropic
# Uncomment to route everything to the on-premise box; per purpose: AI_PROVIDER_CHAT / _EVALUATE / _CRITERIA / _DISCUSS.
# AI_PROVIDER=local
# Where that routing is READ from. database (default): app_settings.ai_provider_* — the superadmin toggle — layered
# over env. env: the database is never consulted; routing follows AI_PROVIDER_<PURPOSE> / AI_PROVIDER only, exactly as
# if no rows existed. Dev-only, for a laptop stack pointed at a shared database whose settings it must neither obey nor
# write (the sandbox smoke; /health/deep reports routing.override=true). REFUSED IN PRODUCTION — rimpl refuses to boot.
# PROVIDER_SETTINGS_SOURCE=database
# Dormant chat fail-over. When set, a `chat` turn whose primary provider is DOWN (connection refused/reset, our own
# deadline, HTTP 5xx) is retried ONCE on this provider and the reply carries failed_over_from. Never for
# evaluate/criteria/discuss; never on queue_full, a hung-up caller, 413 or any other 4xx.
# CREC decision pending — research transcripts must not fall back to a cloud model without an ethics amendment; leave unset.
# CHAT_FAILOVER_PROVIDER=

# --- Local (on-premise) provider: connection --------------------------------------------------
# OpenAI-compatible base URL, reached over the tailnet only (WireGuard end to end; never a plaintext public address).
LOCAL_AI_BASE_URL=http://dgx.tailnet:8000/v1
# The served chat model; ready() refuses to report healthy unless GET /models lists exactly this name.
LOCAL_AI_MODEL=your-served-model
# Bearer token for the local server, if it requires one.
LOCAL_AI_API_KEY=
# Client-side deadline per call (ms). Must stay UNDER backend's RIMPL_EVAL_TIMEOUT_MS or retries are dead work.
LOCAL_AI_TIMEOUT_MS=150000
# Smallest context window ready() accepts (a creditable PLE is >= 10,000 tokens); app_settings.local_ai_min_context overrides.
# LOCAL_AI_MIN_CONTEXT=16384
# Opt-in per-request context override for servers that honour an `options.num_ctx` bag (0 = do not send).
# LOCAL_AI_NUM_CTX=0
# Embedding model for POST /embeddings when EMBED_PROVIDER=local — usually a different checkpoint from the chat model.
# LOCAL_AI_EMBED_MODEL=
# LOCAL_AI_EMBED_TIMEOUT_MS=15000

# --- Local provider: two-lane bounded queue ---------------------------------------------------
# In-flight calls the box may run at once. Measured on the DGX: one PIS-7 evaluation is p50 68s; two
# concurrent push p95 to 114s and four to 154s — over LOCAL_AI_TIMEOUT_MS. Re-measure before raising.
LOCAL_MAX_CONCURRENCY=2
# Slots held back for the interactive lane (chat / criteria / discuss). Background work (evaluate /
# shadow) only ever uses LOCAL_MAX_CONCURRENCY - reserve, so a burst of evaluations never blocks a chat turn.
LOCAL_INTERACTIVE_RESERVE=1
# Waiting calls allowed per lane. Beyond this rimpl answers 503 { code: "queue_full" } at once instead of queueing.
LOCAL_MAX_QUEUE_INTERACTIVE=4
LOCAL_MAX_QUEUE_BACKGROUND=2
# Retry-After (seconds) sent with that 503; the backend's evaluation queue waits at least this long.
LOCAL_QUEUE_RETRY_AFTER_S=30
# Pre-send size backstop, in the server's own prompt-token unit (usage.prompt_tokens). Set it to the largest
# `reported prompt_tokens` at which the capacity probe recalled the sentinel. rimpl converts its byte-based
# estimate through a ratio it learns from served responses; until 3 calls have been observed it never
# pre-rejects. Over the limit -> 413 { code: "transcript_too_large", est_tokens, limit, calibration } before
# any slot is taken, no retry. 0 = off.
LOCAL_AI_MAX_PROMPT_TOKENS=0
# Print one console.debug line per served local call with the learnt ratio (numbers only, never text):
#   [local] prompt est=<bytes/3> served=<usage.prompt_tokens> ratio=<est/served, EWMA> n=<samples>
# Off unless set to exactly 1; /health/deep queues.local.prompt_calibration shows the same ratio without it.
# LOCAL_LOG_PROMPT_RATIO=1
# Retries / backoff for transient local errors (429 / 5xx / network). Our own deadline and a hung-up caller are never retried.
LOCAL_MAX_RETRIES=3
LOCAL_RETRY_BASE_MS=500

# --- Local provider: thinking control + reasoning hygiene --------------------------------------
# How a request's optional `thinking` flag reaches THIS server (nobody passes it yet — a later router will):
#   none (default — never send anything) | chat_template_kwargs (vLLM / SGLang) | ollama
# Sent only when a caller passes `thinking`. Inline <think>…</think> in a reply is always stripped (and withheld
# from a stream); a warning means the server is not separating reasoning — configure its reasoning parser.
# LOCAL_AI_THINKING_STYLE=none

# --- Local TUTOR provider (`local-tutor`, CCME R3: the evaluator must be a distinct model from the tutor) ----
# A SECOND on-prem endpoint for chat / discuss only — `local` above stays the evaluator (evaluate / criteria).
# DORMANT: nothing routes here until ai_provider_chat / _discuss (or AI_PROVIDER_CHAT / _DISCUSS) = local-tutor.
# rimpl refuses evaluate / criteria / embed on it. Same meaning as the LOCAL_AI_* / LOCAL_* variables above,
# own values: own box, own key, own queue, own context floor, own size backstop. /health/deep check: local_tutor_ai.
# LOCAL_TUTOR_AI_BASE_URL=http://tutor.tailnet:8000/v1
# LOCAL_TUTOR_AI_MODEL=your-served-tutor-model
# LOCAL_TUTOR_AI_API_KEY=
# LOCAL_TUTOR_AI_TIMEOUT_MS=150000
# Floor for ready(); app_settings.local_tutor_ai_min_context overrides.
# LOCAL_TUTOR_AI_MIN_CONTEXT=16384
# LOCAL_TUTOR_AI_NUM_CTX=0
# LOCAL_TUTOR_AI_MAX_PROMPT_TOKENS=0
# LOCAL_TUTOR_AI_THINKING_STYLE=none
# Proxy: when this is SET (even to empty = go direct) it wins; when unset the tutor uses LOCAL_AI_HTTP_PROXY.
# LOCAL_TUTOR_AI_HTTP_PROXY=
# LOCAL_TUTOR_MAX_CONCURRENCY=2
# LOCAL_TUTOR_INTERACTIVE_RESERVE=1
# LOCAL_TUTOR_MAX_QUEUE_INTERACTIVE=4
# LOCAL_TUTOR_MAX_QUEUE_BACKGROUND=2
# LOCAL_TUTOR_QUEUE_RETRY_AFTER_S=30
# LOCAL_TUTOR_MAX_RETRIES=3
# LOCAL_TUTOR_RETRY_BASE_MS=500
# LOCAL_TUTOR_LOG_PROMPT_RATIO=1

# --- Evaluator: self-consistency (docs/LOCAL-MODEL-ROADMAP.md D18 / D21) -----------------------
# off (default) | adaptive | median3. Applies to the LOCAL provider only. adaptive: two scoring calls, a third when
# the pair disagrees (see EVAL_CONSISTENCY_MAX_SUM_DELTA), final = per-domain median (rationale from the closest
# call). median3: always three calls, per-domain median, no pairwise short-cut. The physician is billed call 1
# only; the extra calls are recorded in the response's / provenance's `consistency` block. Anthropic is unchanged.
#
# TIMEOUT COUPLING — read before switching adaptive on. Adaptive issues 2–3 (plus up to EVAL_JSON_RETRIES re-ask)
# SERIAL calls per evaluation through the local box's background lane. The backend's RIMPL_EVAL_TIMEOUT_MS (480 s)
# and EVAL_LEASE_S (600 s) are sized for eval_drain_concurrency = 1. With a drain concurrency of N, the calls of N
# evaluations interleave in that lane and the LAST one finishes at ~3 x N x T, where T is one call (measured
# p50 68 s, p95 ~115 s). So either keep the drain at 1, or size both timeouts to >= 3 x N x p95 first — otherwise
# the backend hangs up mid-run, the third call is cut off, and the evaluation is retried from scratch.
# EVAL_CONSISTENCY=off
# adaptive only: Σ|Δ| over d1..d7 above which the pair does NOT agree (0 = per-domain check alone, max |Δ| ≤ 1).
# Why: a uniform ±1 level shift across 5–6 domains passes the per-domain check with Σ|Δ| 5–6, and the D18
# repeatability bar is Σ|Δ| median ≤ 2 — set 2 to send such a pair to the third call. Read by the shadow arm too.
# EVAL_CONSISTENCY_MAX_SUM_DELTA=0
# Re-asks allowed across ONE adaptive / median3 evaluation when the model returns unparseable / out-of-range JSON (then 502).
# EVAL_JSON_RETRIES=2
# The same rule (off | adaptive | median3) for the SHADOW evaluation. Default off: three shadow calls per PLE is the
# load the shed rule exists to prevent.
# Measurement caveat: the shadow NEVER re-asks (a garbage reply is recorded as the failure it is), so the candidate's
# contract rate computed from shadow_evaluations.error stays honest; a `consistency` column on shadow_evaluations would
# be needed before the extra calls could be kept.
# SHADOW_EVAL_CONSISTENCY=off
