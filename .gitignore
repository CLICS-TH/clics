node_modules/
.env
.DS_Store
*.log
.claude/
.playwright-mcp/
*.docx
# ...except generated reports, which are deliverables built by scripts/probe/report/ and contain
# no manuscript or participant text. The bare *.docx rule above guards the manuscript set.
!docs/reports/*.docx
*.jpg
*.rtf

# Credentials — never track real or demo logins / generated participant passwords
LOGIN-ACCOUNTS.txt
scripts/provision/roster.json
scripts/provision/credentials-*.txt
scripts/provision/test-credentials-*.txt
docs/manuals/source/test-login-guide-th.html
docs/manuals/test-login-guide-th.pdf
*.creds

# Evaluation working files. rujdanai-eval-*.html carry a REAL physician's name alongside their
# scored transcripts — untracked but, until this entry, one `git add -A` away from being in the
# history permanently. Nothing under here belongs in git, and none of it may reach a cloud model.
scripts/report/

# Daily-summary ephemeral working file (generated by gen_summary.py on the GH Actions runner)
data.json

# Python bytecode
__pycache__/
*.pyc

# Understand-Anything analysis artifacts (regenerable via /understand; ~1 MB graph + scratch)
.ua/
.understand-anything/

# Test-coverage output (regenerable; 50+ files that otherwise swamp `git status`)
coverage/

# Unpublished manuscript + proposal materials, and generated evaluation reports.
# `*.docx` above already covered the Word files, but NOT the PDF/HTML siblings —
# these carry the unpublished JMIR submission and a real physician's name.
Manuscript/
_materials/
scripts/report/*.html
scripts/report/*.pdf
rujdanai-*

# CREC/IRB submission set. These are the ethics committee's own documents — the approved protocol,
# the ICFs, the SAP, the Model Lock Record — and they carry the principal investigator's real name
# alongside the study design. They govern what the code must do; they are not part of the code.
CREC082_*/
.ds-sync/
ds-bundle/
# design-sync tool output. Three subpaths were already ignored and the rest were not, so a
# `git add -A` would have committed a generated design system nothing in the app imports.
.design-sync/
audit-dashboard/.ds-styles.css
audit-dashboard/dist/
audit-dashboard/design-system.ts
audit-dashboard/design-system.css
audit-dashboard/design-system-shim.ts
audit-dashboard/tsconfig.design-system.json
audit-dashboard/docs/

# Anchor SANDBOX import manifests + rollback exports (scripts/calibration/anchors/import-sandbox.mjs).
# Deployment-specific (live PLE ids, the SANDBOX physician/council ids) and, for a rollback export,
# human auditor scores — local working files, never committed.
scripts/calibration/anchors/imports/

# Physician sandbox reports (scripts/booth/sandbox.mjs): the JSON stays local, the .md summary may be committed.
scripts/booth/sandbox-runs/*.json

# Open booth dataset builds: production-derived plays and the private list of flagged typed text. Never committed.
scripts/booth/open-dataset/
